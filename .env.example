# Multi-LLM Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default Provider to use: "gemini" or "openrouter"
DEFAULT_LLM_PROVIDER=gemini

# Optional: Model overrides
# Gemini examples: "gemini-2.5-flash", "gemini-2.5-pro", "gemini-1.5-flash"
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter examples: "openai/gpt-4o-mini", "anthropic/claude-3.7-sonnet", "deepseek/deepseek-chat"
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: Next.js public site URL for Vercel
NEXT_PUBLIC_SITE_URL=http://localhost:3000
